APP_NAME=Smartfreight
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000,https://freightbook.ai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartfreight
DB_USERNAME=smartfreight
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# Lena's ear. Whisper Large v3 Turbo on Groq is the fastest transcription OpenRouter serves; the
# fallback is tried only when the primary fails or returns an empty transcript.
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TRANSCRIPTION_FALLBACK_MODEL=openai/whisper-1
# Whisper Large v3 has several providers; pinning keeps the primary on Groq. Blank = let OpenRouter pick.
OPENROUTER_TRANSCRIPTION_PROVIDER=groq
OPENROUTER_TRANSCRIPTION_URL=https://openrouter.ai/api/v1/audio/transcriptions

# Lena's web search. Attached only to replies the skill selector judged to need it; OpenRouter
# bills roughly $0.007 per search. Set to false to switch it off everywhere.
OPENROUTER_WEB_SEARCH_ENABLED=true
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5

# Lena's live call only. A realtime session is a persistent WebRTC connection, which OpenRouter
# does not serve, so this one feature talks straight to OpenAI - everything else stays on
# OpenRouter. Leave OPENAI_API_KEY blank and the call button reports itself as not set up; no
# other part of the app is affected.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

APPLE_CLIENT_IDS=freightbook.qla.dev

FUELO_BASE_URL=https://de.fuelo.net/
FUELO_STATIONS_URL=https://de.fuelo.net/ajax/get_gasstations_within_bounds_mysql_clustering
FUELO_PYTHON_BINARY=python3

AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
